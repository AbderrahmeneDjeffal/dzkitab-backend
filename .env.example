NODE_ENV=development
PORT=5000

# Development uses the DB_* values, production uses DB_URI
DB_URI=postgresql://postgres:postgres@localhost:5432/dzkitab
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=dzkitab

JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
SALT_ROUNDS=10

# Optional. Leave MAILER_* empty and e-mails are only printed in the server logs.
MAILER_HOST=
MAILER_PORT=587
MAILER_USER=
MAILER_PASSWORD=

# Production only: URL(s) of the frontend allowed by CORS (comma separated)
FRONTEND_URL=
